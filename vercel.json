{
  "rewrites": [
    {
      "source": "/card/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|Slackbot|Discordbot|LinkedInBot|Googlebot|Pinterest|redditbot|Applebot|SkypeUriPreview|vkShare|W3C_Validator|Bitrix link preview|iframely|Embedly).*"
        }
      ],
      "destination": "/api/card-meta?slug=:slug"
    },
    {
      "source": "/ask/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|Slackbot|Discordbot|LinkedInBot|Googlebot|Pinterest|redditbot|Applebot|SkypeUriPreview|vkShare|W3C_Validator|Bitrix link preview|iframely|Embedly).*"
        }
      ],
      "destination": "/api/ask-meta?username=:username"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}
